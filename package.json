{
  "name": "hono-lit-html-ssr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "build": "vite build && vite build --ssr src/server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:dev": "TEST_MODE=development playwright test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "hono": "4.13.14",
    "lit-html": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
